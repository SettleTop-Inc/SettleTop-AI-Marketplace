{
  "name": "settletop-ai-registry",
  "version": "0.1.0",
  "private": true,
  "description": "SettleTop AI Registry — a provenance registry for AI agents.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test lib/*.test.ts",
    "test:parity": "node --experimental-strip-types --env-file-if-exists=.env.local --test lib/registry-search.parity.test.ts",
    "harvest:catalog": "node scripts/harvest-catalog.mjs",
    "harvest:detail": "node scripts/harvest-detail.mjs",
    "harvest:pricing": "node scripts/harvest-pricing.mjs",
    "harvest:ingest": "node scripts/harvest-ingest.mjs",
    "harvest:logos": "node scripts/archive-logos.mjs",
    "harvest": "node scripts/harvest.mjs",
    "harvest:drai": "node scripts/harvest.mjs --marketplace drai",
    "harvest:microsoft": "node scripts/harvest.mjs --marketplace microsoft"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "next": "^16.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2"
  }
}
