{
  "name": "settletop-ai-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "SettleTop AI Marketplace — a provenance registry for AI agents.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test lib/*.test.ts",
    "test:parity": "node --experimental-strip-types --env-file-if-exists=.env.local --test lib/registry-search.parity.test.ts",
    "harvest:catalog": "node scripts/harvest-catalog.mjs",
    "harvest:detail": "node scripts/harvest-detail.mjs",
    "harvest:pricing": "node scripts/harvest-pricing.mjs",
    "harvest:ingest": "node scripts/harvest-ingest.mjs",
    "harvest:logos": "node scripts/archive-logos.mjs",
    "harvest": "npm run harvest:catalog && npm run harvest:detail && npm run harvest:pricing && npm run harvest:ingest && npm run harvest:logos"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0"
  }
}
