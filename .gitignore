# Harvest output
data/

# Scratch: agent workspaces and nested worktrees, never part of the record
.superpowers/
.claude/

# Secrets.
#
# Ignore every .env variant and re-admit only the committed template. Rules of
# just `.env` plus `.env*.local` leave `.env.production` and `.env.staging`
# tracked — a filled-in production file would be committed silently.
.env
.env.*
!.env.example

# Key material and credentials in any form
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.jks
*.keystore
id_rsa*
id_ed25519*
*service-account*.json
*credentials*.json
*.secrets.json
secrets.*
.supabase/
.netrc
.npmrc
