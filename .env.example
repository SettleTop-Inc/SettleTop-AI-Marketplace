#
# These two are safe to expose: the publishable key can only read, because the
# registry has public SELECT policies and no INSERT/UPDATE/DELETE policies at
# all. Nothing that writes runs in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://atevamimariwlpidgvog.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xdkreVZHPtKjTJpmfU6acA_-MyZ_mkK

# Server only. Never prefix with NEXT_PUBLIC_, never commit a filled-in copy.
# Only the ingest path needs this: ingest_capture() is granted to service_role
# and revoked from everyone else.
# Get it from Supabase dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=
